# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# LINE flex card preview JSON — derived from lib/line/flex.ts via
# `pnpm line:preview`, for pasting into the Flex Message Simulator
/line-preview/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Build directories moved aside rather than deleted — a verification `next
# build` must not share .next with a running `next dev` (the two write
# different server-action manifests, and the mix makes the browser ask for
# action ids the server no longer has). Parking the output under .next-<name>
# keeps that recoverable; this pattern keeps every one of them out of git.
/.next-*/
